{
  "name": "@bureau/core",
  "version": "0.1.0",
  "description": "Bureau core — framework-agnostic agent orchestration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./path-classifier": {
      "types": "./dist/path-classifier/index.d.ts",
      "import": "./dist/path-classifier/index.js"
    },
    "./agents/ssc": {
      "types": "./dist/agents/ssc/index.d.ts",
      "import": "./dist/agents/ssc/index.js"
    },
    "./agents/csuite": {
      "types": "./dist/agents/csuite/index.d.ts",
      "import": "./dist/agents/csuite/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@bureau/shared-kernel": "workspace:*",
    "@bureau/contracts": "workspace:*",
    "@bureau/agents-core": "workspace:*",
    "@bureau/telemetry": "workspace:*",
    "@bureau/models": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
