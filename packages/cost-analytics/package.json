{
  "name": "@bureau/cost-analytics",
  "version": "0.1.0",
  "description": "Bureau cost analytics — LLM invocation cost tracking (write path from day 1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@bureau/shared-kernel": "workspace:*",
    "@bureau/contracts": "workspace:*",
    "@bureau/models": "workspace:*",
    "@bureau/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
