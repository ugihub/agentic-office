# ============================================================
# Bureau — Environment Variables Template
# Copy to .env and fill in real values
# Managed by Doppler in staging/production
# ============================================================

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# Use MongoDB Atlas M0 for development (not local Docker)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bureau?retryWrites=true&w=majority

# ── Redis (BullMQ + cache + rate limiting) ───────────────────
REDIS_URL=redis://localhost:6379
# Production: rediss://default:<password>@<host>:6380

# ── Auth ─────────────────────────────────────────────────────
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=https://auth.bureau.id
JWT_EXPIRY=1h

# 32-byte hex: openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=<32-byte-hex>

# Bootstrap master key — grants ALL permissions without DB lookup.
# Use ONLY for initial setup (create first scoped API key via dashboard, then remove/rotate).
# Min 16 chars. Generate: openssl rand -hex 24
# BUREAU_SUPER_KEY=<your-bootstrap-key>

# ── Email Transactional ───────────────────────────────────────
# AwaitingUserDecision notifications (pick one)
RESEND_API_KEY=re_xxxx
# POSTMARK_API_KEY=xxxx

# ── LLM Providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
GEMINI_API_KEY=AIzaxxxx
MISTRAL_API_KEY=xxxx
DEEPSEEK_API_KEY=xxxx
OPENAI_API_KEY=sk-xxxx

# ── Observability ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bureau

# ── BullMQ Worker Config ──────────────────────────────────────
BULLMQ_CONCURRENCY=8
MAX_LLM_CONCURRENCY=3
BULLMQ_LOCK_DURATION=60000
BULLMQ_STALLED_INTERVAL=30000
BULLMQ_MAX_STALLED_COUNT=2

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins for the API server.
# REQUIRED for local dev: dashboard (3000) → api-server (3001) is cross-origin.
# Leave empty in production if serving via same-origin reverse proxy.
CORS_ORIGINS=http://localhost:3000

# ── Per Service ───────────────────────────────────────────────
DIVISION_NAME=production
API_PORT=3000
MCP_PORT=3002

# ── Semantic Cache ────────────────────────────────────────────
UPSTASH_VECTOR_REST_URL=https://xxxx.upstash.io
UPSTASH_VECTOR_REST_TOKEN=xxxx
SEMANTIC_CACHE_THRESHOLD=0.95
